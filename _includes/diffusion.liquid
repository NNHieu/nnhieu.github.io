<script>
document.addEventListener("DOMContentLoaded", function() {
  const containers = document.querySelectorAll(".diffusion-content");
  if (containers.length === 0) return;

  // Word-level noise vocabulary (you can expand this list)
  const wordBank = [
    "quantum", 
    "signal", 
    "vector", "latent", "drift", "neural",
    "entropy", "flux", "kernel", "matrix", "orbit", "phase",
    "noise", "signal", "graph", "token", "model", "field",
    "relative",
    "machine",
    "learning",
    "optimization",
    "generalization",
    "world",
    "AI",
  ];

  containers.forEach(contentDiv => {

    const textNodes = [];

    function walkNodes(node) {
      if (node.nodeType === Node.TEXT_NODE && node.nodeValue.trim() !== "") {
        textNodes.push(node);
      } else if (node.nodeType === Node.ELEMENT_NODE) {
        for (let child of node.childNodes) walkNodes(child);
      }
    }

    walkNodes(contentDiv);

    // Tokenize each text node into words + separators
    const originalTokens = textNodes.map(n => {
      return n.nodeValue.match(/\w+|\s+|[^\s\w]+/g) || [];
    });

    // Track which WORD tokens are resolved
    const resolvedMasks = originalTokens.map(tokens =>
      tokens.map(tok => {
        // Only words are unresolved; punctuation/spaces auto-resolve
        return !/^\w+$/.test(tok);
      })
    );

    // Initialize noise state
    textNodes.forEach((n, idx) => {
      let noisy = originalTokens[idx].map(tok => {
        if (/^\w+$/.test(tok)) {
          return wordBank[Math.floor(Math.random() * wordBank.length)];
        }
        return tok;
      }).join("");

      n.nodeValue = noisy;
    });

    contentDiv.style.opacity = 1;

    let totalUnresolved = resolvedMasks.reduce(
      (sum, mask) => sum + mask.filter(v => !v).length,
      0
    );

    function diffuseStep() {
      if (totalUnresolved <= 0) return;

      const resolveCount = Math.max(1, Math.floor(totalUnresolved * 0.2));
      let resolvedThisFrame = 0;

      while (resolvedThisFrame < resolveCount && totalUnresolved > 0) {
        const nodeIdx = Math.floor(Math.random() * textNodes.length);
        const tokenIdx = Math.floor(Math.random() * originalTokens[nodeIdx].length);

        if (!resolvedMasks[nodeIdx][tokenIdx]) {
          resolvedMasks[nodeIdx][tokenIdx] = true;
          resolvedThisFrame++;
          totalUnresolved--;
        }
      }

      // Re-render
      textNodes.forEach((n, idx) => {
        let str = "";
        for (let i = 0; i < originalTokens[idx].length; i++) {
          if (resolvedMasks[idx][i]) {
            str += originalTokens[idx][i];
          } else {
            if (/^\w+$/.test(originalTokens[idx][i])) {
              str += wordBank[Math.floor(Math.random() * wordBank.length)];
            } else {
              str += originalTokens[idx][i];
            }
          }
        }
        n.nodeValue = str;
      });

      setTimeout(diffuseStep, 80);
    }

    setTimeout(diffuseStep, 500);
  });
});
</script>
<noscript>
  <style>
    /* Override the inline opacity for the auto-regressive and diffusion effects */
    .autoregressive-content, 
    .diffusion-content {
      opacity: 1 !important;
    }

    /* Override the display:none for the experience carousel */
    .experience-item {
      display: block !important;
      margin-bottom: 1rem; /* Adds spacing since they will now stack vertically */
    }
  </style>
</noscript>